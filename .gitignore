# Raw competition data (not redistributable and too large for Git)
/dataset-*/
/resources-*/

# Python environments and caches
/.venv/
/venv/
/**/.venv/
/**/venv/
/**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dataset audit: generated database and runtime log
/analysis/cache/
/analysis/run.log

# Original blocking benchmark: bulky candidate artifacts and logs
/blocking/artifacts/*.gz
/blocking/artifacts/*.tsv
/blocking/benchmark.log

# Main pipeline: all rebuildable or submission-time artifacts
/primary_pipeline/cache/
/primary_pipeline/features/
/primary_pipeline/logs/
/primary_pipeline/models/
/primary_pipeline/oof/
/primary_pipeline/output/
/primary_pipeline/predictions/
/primary_pipeline/submissions/
/primary_pipeline/blocker/*/
/primary_pipeline/blocker/**/*.parquet

# Baseline pipeline: rebuildable or submission-time artifacts
/baseline_pipeline/cache/
/baseline_pipeline/models/
/baseline_pipeline/output/
/baseline_pipeline/artifacts/
/baseline_pipeline/v2/

# Generic experiment residue
*.log
*.out
*.err
*.bak
*.sqlite
*.sqlite3
*.parquet
