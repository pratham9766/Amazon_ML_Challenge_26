/.venv/
/venv/
/**/.venv/
/**/venv/
/**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

